{
  "name": "@pinax/mcp",
  "description": "An MCP Client for connecting to MCP Server‐compatible services at https://app.pinax.network.",
  "type": "module",
  "version": "0.3.0",
  "homepage": "https://github.com/pinax-network/pinax-mcp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pinax-network/pinax-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/pinax-network/pinax-mcp/issues"
  },
  "license": "Apache-2.0",
  "keywords": [
    "mcp",
    "stdio",
    "ai",
    "llm",
    "blockchain"
  ],
  "bin": {
    "pinax-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "index.ts"
  ],
  "authors": [
    {
      "name": "Etienne Donneger",
      "email": "etienne@pinax.network",
      "url": "https://github.com/0237h"
    }
  ],
  "contributors": [
    {
      "name": "Denis Carriere",
      "email": "denis@pinax.network",
      "url": "https://github.com/DenisCarriere"
    }
  ],
  "scripts": {
    "dev": "bun --watch index.ts",
    "prepublishOnly": "bun build ./index.ts --outdir ./dist --target=node",
    "start": "bun index.ts",
    "test": "bun test --coverage --pass-with-no-tests",
    "clean": "rm -rf node_modules && bun install --frozen-lockfile",
    "lint": "tsc --noEmit --skipLibCheck --pretty",
    "inspector": "mcp-inspector"
  },
  "devDependencies": {
    "@modelcontextprotocol/inspector": "2.10.1",
    "@types/bun": "1.3.2"
  },
  "peerDependencies": {
    "typescript": "^5.8.2"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.21.1",
    "commander": "^13.1.0",
    "dotenv": "^16.6.1",
    "zod": "^3.25.76"
  },
  "module": "index.ts",
  "packageManager": "bun@1.4.3",
  "engines": {
    "bun": ">=1.4.3"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "onFail": "error"
    }
  }
}